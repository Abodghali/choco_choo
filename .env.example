# Local development origin; use an HTTPS origin when deploying.
APP_URL=http://localhost:3000
# Set a unique password of at least 12 characters. No default login exists.
ADMIN_PASSWORD=
# Generate at least 32 random characters. Never commit secrets.
JWT_SECRET=
# Use SumUp sandbox credentials for testing; missing credentials disable card payments.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Preferred Supabase server key (sb_secret_...). Legacy SERVICE_ROLE_KEY also supported.
SUPABASE_SECRET_KEY=
